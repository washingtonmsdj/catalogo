# Deixe vazio para usar o modo demonstração local.
# Depois do deploy do Worker Cloudflare, informe a origem da API sem barra final.
VITE_API_BASE_URL=

# Origem pública/CDN das variantes de imagem no R2, sem barra final.
# Exemplo futuro: https://media.catalogo.tonecosstudios.com.br
VITE_MEDIA_BASE_URL=

# Chave PUBLICA do widget Cloudflare Turnstile usada pelo formulário de orçamento.
# O secret correspondente nunca deve entrar neste arquivo nem no frontend.
VITE_TURNSTILE_SITE_KEY=
